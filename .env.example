# Copie ce fichier en .env et remplis les valeurs.
# .env est chargé automatiquement (python-dotenv) par geoeval/db/session.py et geoeval/core/llm_clients.py.

# --- Base de données PostgreSQL (obligatoire) ---
# Format SQLAlchemy. Avec psycopg2 :
DATABASE_URL=postgresql+psycopg2://geoeval:geoeval@localhost:5432/geoeval
# Avec psycopg (v3), utiliser plutôt :
# DATABASE_URL=postgresql+psycopg://geoeval:geoeval@localhost:5432/geoeval

# --- Clés API LLM (seulement celles des providers que tu utilises) ---
# Ce sont des clés de plateforme développeur, PAS des comptes web (facturation à l'usage).
# OpenRouter = provider plateforme par défaut (ADR-080) : une seule clé pour tous
# les modèles testés (OpenAI, Mistral, Gemini, …).
OPENROUTER_API_KEY=sk-or-v1-...  # https://openrouter.ai/settings/keys
OPENAI_API_KEY=sk-...            # https://platform.openai.com
MISTRAL_API_KEY=...              # https://console.mistral.ai
GEMINI_API_KEY=...               # https://aistudio.google.com  (Google AI Studio)

# --- Conversion du coût réel OpenRouter (ADR-080 §6.3) ---
# usage.cost est facturé en USD ; cost_eur = cost_usd × USD_EUR_RATE à l'ingestion.
USD_EUR_RATE=0.88

# --- BYOK (ADR-078, PR#14) ---
# Clé maître Fernet (base64 urlsafe, 32 octets). Génère-en une :
#     python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# La perte de cette clé rend IRRÉCUPÉRABLES les clés BYOK stockées en base.
# Sur le VPS, elle est posée dans /opt/apps/geoeval/.env (survit aux pulls).
GEOEVAL_KEY_SECRET=

# --- Auth applicative (ADR-086) ---
# Secret des cookies de session (obligatoire en prod — sessions perdues à chaque
# redémarrage sinon). Génère-en un :
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GEOEVAL_SESSION_SECRET=
# Cookie Secure (à poser à 1 derrière HTTPS — prod).
GEOEVAL_COOKIE_SECURE=0
# Bootstrap admin plateforme : ces emails sont promus admin à la connexion
# (promotion seule, jamais de rétrogradation — gérer ensuite via /admin/users).
GEOEVAL_ADMIN_EMAILS=bertrand@matge.com
# Réversibilité ADR-060/077 : à 1, les headers X-Gate-* du proxy valent
# identité (redéploiement derrière le gate). Défaut 0 : sessions applicatives.
AUTH_PROXY_ENABLED=0

# --- SSO OIDC optionnel (ADR-086 §3 — jamais un impératif) ---
# Désactivé par défaut. Authentik aujourd'hui, ProConnect demain : mêmes vars.
OIDC_ENABLED=0
OIDC_ISSUER=            # ex. https://auth.miweb.run/application/o/geoeval/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROFILE=           # generic (défaut, Authentik) | proconnect — fixe les défauts ci-dessous
OIDC_SCOPES=            # vide = défaut du profil (generic : "openid email profile")
OIDC_PROVIDER_LABEL=    # vide = défaut du profil (Authentik / ProConnect)
OIDC_TRUST_EMAIL=       # 1 = l'email vaut attestation sans email_verified (défaut : 0 ; proconnect : 1)
# Correspondance des claims (vide = défaut du profil) :
OIDC_CLAIM_EMAIL=
OIDC_CLAIM_GIVEN_NAME=
OIDC_CLAIM_FAMILY_NAME= # proconnect : usual_name
OIDC_CLAIM_SIRET=
OIDC_CLAIM_IDP=
OIDC_ADMIN_GROUP=       # TRANSITOIRE Authentik (ex. lab-team). Laisser vide avec ProConnect :
                        # les rôles vivent dans l'app (ADR-089), bootstrap via GEOEVAL_ADMIN_EMAILS

# --- Worker (ADR-088 lot 1.2) ---
# Les runs sont exécutés par un processus séparé : `python -m geoeval.worker.main`
# (service `worker` du compose). À 1, la même boucle tourne dans un thread du
# processus web : dev local sans second processus, ou repli. Jamais les deux.
GEOEVAL_INLINE_WORKER=0

# --- Emails des notifications (ADR-089 E3 / E7) ---
# Inactif tant que GEOEVAL_SMTP_HOST est vide : les notifications restent visibles dans l'application.
GEOEVAL_SMTP_HOST=
GEOEVAL_SMTP_PORT=587
GEOEVAL_SMTP_USER=
GEOEVAL_SMTP_PASSWORD=
GEOEVAL_SMTP_FROM=geoeval@example.gouv.fr
GEOEVAL_SMTP_STARTTLS=1
GEOEVAL_SMTP_SSL=0
# Base des liens dans les emails (ex. https://geoeval.lab.miweb.run).
GEOEVAL_PUBLIC_URL=
# Détecteur « question toujours fausse » (E7) : défauts plateforme, surchargeables par entité.
GEOEVAL_ALWAYS_WRONG_RUNS=        # évaluations consécutives (défaut 3, 2 à 20)
GEOEVAL_ALWAYS_WRONG_THRESHOLD=   # note de réponse sur 10 (défaut 5)
# Détecteur « chute des citations officielles » (suite E7) : écart en points sous la moyenne des 3 runs précédents.
GEOEVAL_CITATION_DROP_POINTS=     # défaut 20, 1 à 100
# Heure du récapitulatif quotidien des notifications (heure de Paris, HH:MM).
GEOEVAL_DIGEST_TIME=              # défaut 07:45

# --- Observabilité (ADR-088 lot 1.5) ---
# Format des logs sur stdout : json (défaut hors terminal, conteneurs) ou text (défaut en terminal).
GEOEVAL_LOG_FORMAT=
GEOEVAL_LOG_LEVEL=INFO
# Port interne des sondes du worker (/healthz, /readyz, /metrics) — jamais publié.
GEOEVAL_WORKER_PORT=9100

# --- Dev local uniquement ---
# DEV_FAKE_EMAIL simule un user connecté SANS mot de passe ni session — ne
# JAMAIS poser en prod (n'importe quel visiteur serait connecté avec ce compte).
DEV_FAKE_EMAIL=bertrand@matge.com
# Groupes en dev (CSV). « lab-team » = admin plateforme.
DEV_FAKE_GROUPS=lab-team
